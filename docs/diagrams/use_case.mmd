flowchart LR
    Student(["Student / User"])

    Student --> UC1["Start the application<br/>python -m app"]
    Student --> UC2["Choose the camera, model<br/>and confidence threshold"]
    Student --> UC3["Watch objects being detected<br/>on the live video"]
    Student --> UC4["Read the live statistics<br/>objects, classes, FPS"]
    Student --> UC5["Change the confidence<br/>threshold while running"]
    Student --> UC6["Save a snapshot<br/>of the current frame"]
    Student --> UC7["Clear the session statistics"]
    Student --> UC8["Quit the application<br/>Q or ESC"]

    UC3 -.->|"includes"| UC9["Run YOLO11n inference<br/>on each frame"]
    UC6 -.->|"includes"| UC10["Write a JPEG to outputs/"]
    UC8 -.->|"includes"| UC11["Write session_summary.json"]

    classDef actor fill:#2f4a2f,stroke:#9fe59f,color:#ffffff
    classDef usecase fill:#1f3b57,stroke:#7fb2e5,color:#ffffff
    classDef included fill:#3b3b1f,stroke:#e5e57f,color:#ffffff

    class Student actor
    class UC1,UC2,UC3,UC4,UC5,UC6,UC7,UC8 usecase
    class UC9,UC10,UC11 included
