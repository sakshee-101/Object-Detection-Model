flowchart TD
    User([User]) -->|"python -m app"| Main

    Main["app/main.py<br/>argument parsing + main loop"]

    Main --> Camera["app/camera.py<br/>Camera"]
    Main --> Detector["app/detector.py<br/>Detector"]
    Main --> Analytics["app/analytics.py<br/>FpsCounter, SessionStats"]
    Main --> Controls["app/controls.py<br/>key handling"]
    Main --> Renderer["app/renderer.py<br/>Renderer"]

    Camera -->|"frame"| Detector
    Detector -->|"list of Detection"| Analytics
    Detector -->|"list of Detection"| Renderer
    Analytics -->|"FPS and counts"| Renderer
    Renderer -->|"annotated frame"| Main
    Controls -->|"Action"| Main

    Detector --> YOLO["YOLO11n<br/>pretrained model<br/>(third-party: Ultralytics)"]

    Main --> Window["OpenCV window<br/>live annotated video"]
    Main --> Files["outputs/<br/>snapshot_*.jpg<br/>session_summary.json"]

    Window --> User
    Files --> User

